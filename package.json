{
  "name": "@balpal4495/quorum",
  "version": "3.3.2",
  "description": "Git-backed memory and design review for AI coding agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balpal4495/Quorum.git"
  },
  "homepage": "https://github.com/balpal4495/Quorum#readme",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "agent-memory",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "llm",
    "developer-tools",
    "typescript"
  ],
  "bin": {
    "quorum": "bin/quorum.js"
  },
  "files": [
    "dist/**",
    "bin/**",
    "SETUP.md",
    "GEMINI.md",
    ".github/copilot-instructions.md",
    "modules/AGENTS.md"
  ],
  "exports": {
    ".": "./dist/setup.js",
    "./oracle": "./dist/oracle/index.js",
    "./advisor": "./dist/advisor/index.js",
    "./jury": "./dist/jury/index.js",
    "./council": "./dist/council/index.js",
    "./sentinel": "./dist/sentinel/index.js",
    "./compass": "./dist/compass/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run modules/ evals/",
    "test:watch": "vitest modules/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.0",
    "vectordb": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
